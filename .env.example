# Database (local Docker, see docker-compose.yml)
DATABASE_URL="postgresql://clinica:clinica_dev@localhost:5435/clinica_turnos"

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Seed (fictional demo users, dev only)
SEED_PASSWORD=Demo1234!
# Optional: separate password for doctor@demo.test only (read-only role), so it can be shared
# publicly (portfolio) without exposing admin and reception. Empty = it uses SEED_PASSWORD.
# In production, if set, it must be at least 10 characters.
SEED_DOCTOR_PASSWORD=

# Bot (phase 4)
# Set BOT_ENABLED=true to connect WhatsApp when the API starts.
BOT_ENABLED=false
# Clinic the bot answers for. Empty = the first clinic created.
BOT_CLINICA_ID=
# Numbers the assistant answers (comma separated, any format: 3770123456 or +5493770123456). EMPTY = answers everyone.
# Set it when the linked number is also used for personal chats, so only the people in the demo get answers.
BOT_ALLOWED_PHONES=
# WhatsApp transport: "meta" (official Cloud API, recommended), "baileys" (unofficial, secondary SIM) or "console" (terminal chat).
WHATSAPP_PROVIDER=baileys
# Folder where Baileys keeps the linked-device session. NEVER commit it.
BAILEYS_AUTH_DIR=./.baileys-auth
# LLM providers, in order of preference (comma separated). Default: "groq,gemini" when GROQ_API_KEY is set, else "gemini".
LLM_PROVIDER=
# Groq (free tier, very fast). Key at https://console.groq.com/keys, put it ONLY in .env / Railway variables.
GROQ_API_KEY=
# One or several models (tried in order). List the available ones with: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=10000
# LLM backup (Gemini free tier). Get a key at https://aistudio.google.com/apikey and put it ONLY in .env.
GEMINI_API_KEY=
# One or several models separated by commas. The free tier limits requests PER DAY PER MODEL, so when one runs out the next one is used.
GEMINI_MODEL=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
# Seconds a model may take before the next one is tried (free-tier Gemini is sometimes slow/overloaded), and thinking effort.
GEMINI_TIMEOUT_MS=12000
GEMINI_THINKING_LEVEL=low

# Demo tools (chat simulator, reset button). Keep true only on the demo deployment.
DEMO_MODE=true

# --- WhatsApp Cloud API (Meta). Only when WHATSAPP_PROVIDER=meta. See docs/10-whatsapp-meta.md ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# A long random phrase you invent; it must be the same in Meta and here.
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
