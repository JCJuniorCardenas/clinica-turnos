# Database (local Docker, see docker-compose.yml)
DATABASE_URL="postgresql://clinica:clinica_dev@localhost:5435/clinica_turnos"

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Seed (fictional demo users, dev only)
SEED_PASSWORD=Demo1234!

# Bot (phase 4)
# Set BOT_ENABLED=true to connect WhatsApp when the API starts.
BOT_ENABLED=false
# Clinic the bot answers for. Empty = the first clinic created.
BOT_CLINICA_ID=
# WhatsApp transport: "baileys" (demo, secondary SIM) or "console" (terminal chat, no phone).
WHATSAPP_PROVIDER=baileys
# Folder where Baileys keeps the linked-device session. NEVER commit it.
BAILEYS_AUTH_DIR=./.baileys-auth
# LLM (Gemini free tier). Get a key at https://aistudio.google.com/apikey and put it ONLY in .env.
GEMINI_API_KEY=
# One or several models separated by commas. The free tier limits requests PER DAY PER MODEL, so when one runs out the next one is used.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Demo tools (chat simulator, reset button). Keep true only on the demo deployment.
DEMO_MODE=true
